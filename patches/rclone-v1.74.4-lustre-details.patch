+//go:build !plan9
+
+package sftp
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	pkgSftp "github.com/pkg/sftp"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/config/obscure"
+	_ "github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/rc"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/knownhosts"
+)
+
+// Exercise the production SSH connection pool and operations/about RC route.
+// The server returns quota command output; Unix shell formatting is covered
+// separately by TestLustreQuotaCommand. This transport test runs on Windows too.
+func TestLustreQuotaRCReusesAuthenticatedSession(t *testing.T) {
+	for _, auth := range []string{"password", "private-key"} {
+		t.Run(auth, func(t *testing.T) {
+			root := t.TempDir()
+			_, privateKey, err := ed25519.GenerateKey(rand.Reader)
+			require.NoError(t, err)
+			signer, err := ssh.NewSignerFromKey(privateKey)
+			require.NoError(t, err)
+			cfg := &ssh.ServerConfig{}
+			cfg.PasswordCallback = func(_ ssh.ConnMetadata, password []byte) (*ssh.Permissions, error) {
+				if auth == "password" && string(password) == "fixture-password" {
+					return nil, nil
+				}
+				return nil, fmt.Errorf("unexpected password authentication")
+			}
+			cfg.PublicKeyCallback = func(_ ssh.ConnMetadata, key ssh.PublicKey) (*ssh.Permissions, error) {
+				if auth == "private-key" && bytes.Equal(key.Marshal(), signer.PublicKey().Marshal()) {
+					return nil, nil
+				}
+				return nil, fmt.Errorf("unexpected key authentication")
+			}
+			cfg.AddHostKey(signer)
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = listener.Close() })
+			var connections atomic.Int32
+			var commands atomic.Int32
+			go func() {
+				for {
+					raw, err := listener.Accept()
+					if err != nil {
+						return
+					}
+					connections.Add(1)
+					go func() {
+						defer raw.Close()
+						_ = raw.SetDeadline(time.Now().Add(20 * time.Second))
+						conn, channels, requests, err := ssh.NewServerConn(raw, cfg)
+						if err != nil {
+							return
+						}
+						defer conn.Close()
+						go ssh.DiscardRequests(requests)
+						for incoming := range channels {
+							channel, requests, err := incoming.Accept()
+							if err != nil {
+								return
+							}
+							go func() {
+								defer channel.Close()
+								for request := range requests {
+									switch request.Type {
+									case "subsystem":
+										var payload struct{ Name string }
+										if ssh.Unmarshal(request.Payload, &payload) != nil || payload.Name != "sftp" {
+											_ = request.Reply(false, nil)
+											continue
+										}
+										_ = request.Reply(true, nil)
+										server, err := pkgSftp.NewServer(channel)
+										if err == nil {
+											_ = server.Serve()
+											_ = server.Close()
+										}
+										return
+									case "exec":
+										var payload struct{ Command string }
+										_ = ssh.Unmarshal(request.Payload, &payload)
+										_ = request.Reply(true, nil)
+										status := uint32(1)
+										if strings.Contains(payload.Command, "lfs quota -p") {
+											commands.Add(1)
+											_, _ = io.WriteString(channel, "40000 30000 100000 700 500 1000\n")
+											status = 0
+										}
+										_, _ = channel.SendRequest("exit-status", false, ssh.Marshal(struct{ Status uint32 }{status}))
+										return
+									default:
+										_ = request.Reply(false, nil)
+									}
+								}
+							}()
+						}
+					}()
+				}
+			}()
+			host, port, err := net.SplitHostPort(listener.Addr().String())
+			require.NoError(t, err)
+			trust := filepath.Join(root, "known_hosts")
+			require.NoError(t, os.WriteFile(trust, []byte(knownhosts.Line([]string{listener.Addr().String()}, signer.PublicKey())+"\n"), 0600))
+			options := configmap.Simple{
+				"host": host, "port": port, "user": "fixture", "known_hosts_file": trust,
+				"host_key_algorithms": "ssh-ed25519", "lustre_quota": "true", "shell_type": "unix", "disable_hashcheck": "true",
+			}
+			if auth == "password" {
+				options["pass"] = obscure.MustObscure("fixture-password")
+			} else {
+				block, err := ssh.MarshalPrivateKey(privateKey, "fixture")
+				require.NoError(t, err)
+				keyPath := filepath.Join(root, "login-key")
+				require.NoError(t, os.WriteFile(keyPath, pem.EncodeToMemory(block), 0600))
+				options["key_file"] = keyPath
+			}
+			ctx := context.Background()
+			name := "quota-" + auth
+			remoteDirectory := filepath.Join(root, "project with spaces")
+			require.NoError(t, os.Mkdir(remoteDirectory, 0700))
+			remoteRoot := filepath.ToSlash(remoteDirectory)
+			info, err := fs.Find("sftp")
+			require.NoError(t, err)
+			mapper := fs.ConfigMap("sftp", info.Options, name, options)
+			backend, err := NewFs(ctx, name, remoteRoot, mapper)
+			require.NoError(t, err)
+			t.Cleanup(func() { _ = backend.(*Fs).Shutdown(ctx) })
+			remote := name + ":" + remoteRoot
+			cache.Put(remote, backend)
+			t.Cleanup(func() { cache.Clear() })
+			// No external SSH config or usable on-disk credentials are needed by RC.
+			delete(options, "pass")
+			delete(options, "key_file")
+			call := rc.Calls.Get("operations/about")
+			require.NotNil(t, call)
+			for range 2 {
+				out, err := call.Fn(ctx, rc.Params{"fs": remote})
+				require.NoError(t, err)
+				details, ok := out["lustreQuota"].(map[string]any)
+				require.True(t, ok, "%#v", out)
+				require.Equal(t, float64(30720000), details["softTotal"])
+				require.Equal(t, float64(700), details["inodesUsed"])
+				require.Equal(t, float64(1000), details["inodesTotal"])
+				require.Equal(t, float64(500), details["inodesSoftTotal"])
+			}
+			require.Equal(t, int32(2), commands.Load())
+			require.Equal(t, int32(1), connections.Load(), "capacity refresh opened another SSH connection")
+		})
+	}
+}
