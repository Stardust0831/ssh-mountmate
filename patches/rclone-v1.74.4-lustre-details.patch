+func TestLustreQuotaDetails(t *testing.T) {
+	u := parseLustreQuota([]byte("40000 30000 100000 700 500 1000"))
+	require.NotNil(t, u)
+	require.Equal(t, int64(102400000), *u.Total)
+	require.Equal(t, int64(30720000), *u.LustreQuota.SoftTotal)
+	require.Equal(t, int64(700), *u.LustreQuota.InodesUsed)
+	require.Equal(t, int64(1000), *u.LustreQuota.InodesTotal)
+	require.Equal(t, int64(500), *u.LustreQuota.InodesSoftTotal)
+	// RC reshapes Usage through JSON; these fields must survive that boundary.
+	payload, err := json.Marshal(u)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"total":102400000,"used":40960000,"free":61440000,"lustreQuota":{"softTotal":30720000,"inodesUsed":700,"inodesTotal":1000,"inodesSoftTotal":500}}`, string(payload))
+	for _, input := range []string{
+		"40 0 100 7 0 0", "40 - 100 7 - -", "40 101 100 7 5 0",
+	} {
+		u := parseLustreQuota([]byte(input))
+		require.NotNil(t, u)
+		require.Nil(t, u.LustreQuota.SoftTotal)
+		require.Nil(t, u.LustreQuota.InodesTotal)
+	}
+	equal := parseLustreQuota([]byte("40 100 100 7 10 10"))
+	require.Equal(t, int64(102400), *equal.LustreQuota.SoftTotal)
+	require.Equal(t, int64(10), *equal.LustreQuota.InodesSoftTotal)
+}
