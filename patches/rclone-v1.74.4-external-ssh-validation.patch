--- /dev/null
+++ b/backend/sftp/ssh_startup_diagnostics.go
@@ -0,0 +1,32 @@
+//go:build !plan9
+
+package sftp
+
+import (
+	"strings"
+	"sync"
+)
+
+// Keep only a bounded error prefix; successful long-lived sessions may write
+// arbitrary amounts of stderr. Stdout remains an untouched SFTP byte stream.
+type sshStartupDiagnostics struct {
+	mu   sync.Mutex
+	data []byte
+}
+
+func (d *sshStartupDiagnostics) Write(p []byte) (int, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	remaining := 4096 - len(d.data)
+	if remaining > len(p) {
+		remaining = len(p)
+	}
+	d.data = append(d.data, p[:remaining]...)
+	return len(p), nil
+}
+
+func (d *sshStartupDiagnostics) String() string {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return strings.TrimSpace(string(d.data))
+}
--- /dev/null
+++ b/backend/sftp/ssh_startup_diagnostics_test.go
@@ -0,0 +1,22 @@
+//go:build !plan9
+
+package sftp
+
+import (
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestSSHStartupDiagnosticsAreBounded(t *testing.T) {
+	var d sshStartupDiagnostics
+	message := []byte(strings.Repeat("x", 10000))
+	n, err := d.Write(message)
+	require.NoError(t, err)
+	require.Equal(t, len(message), n)
+	require.Len(t, d.String(), 4096)
+	n, err = d.Write([]byte("discarded"))
+	require.NoError(t, err)
+	require.Equal(t, 9, n)
+	require.Len(t, d.String(), 4096)
+}
