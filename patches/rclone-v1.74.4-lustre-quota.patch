diff --git a/backend/sftp/lustre_quota_test.go b/backend/sftp/lustre_quota_test.go
new file mode 100644
--- /dev/null
+++ b/backend/sftp/lustre_quota_test.go
@@ -0,0 +1,84 @@
+//go:build !plan9
+
+package sftp
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseLustreQuota(t *testing.T) {
+	for _, tc := range []struct {
+		input             string
+		total, used, free int64
+	}{
+		{"40000 100000\n", 102400000, 40960000, 61440000},
+		{"1200 1000", 1024000, 1228800, 0},
+		{"1000 1000", 1024000, 1024000, 0},
+		{"0 1000", 1024000, 0, 1024000},
+	} {
+		u := parseLustreQuota([]byte(tc.input))
+		require.NotNil(t, u, tc.input)
+		require.Equal(t, tc.total, *u.Total)
+		require.Equal(t, tc.used, *u.Used)
+		require.Equal(t, tc.free, *u.Free)
+	}
+	for _, input := range []string{"", "banner", "1 2 extra", "1 0", "1 -", "1 --", "-1 2", "1 -2", "9223372036854775807 2", "1 9223372036854775807"} {
+		require.Nil(t, parseLustreQuota([]byte(input)), input)
+	}
+}
+
+func TestLustreQuotaCommand(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("remote Unix shell fixture runs on Linux and macOS")
+	}
+	bin := t.TempDir()
+	writeTool := func(name, body string) {
+		require.NoError(t, os.WriteFile(filepath.Join(bin, name), []byte("#!/bin/sh\n"+body), 0700))
+	}
+	writeTool("df", `printf 'Filesystem Type Blocks Used Available Use%% Mounted\nmock %s 100 100 0 100%% /lustre\n' "$TEST_FS"`)
+	writeTool("readlink", `[ "$3" = "$TEST_PATH" ] || exit 1; printf '%s\n' "$TEST_RESOLVED"`)
+	writeTool("lfs", `case "$1" in
+project) [ "$3" = "$TEST_RESOLVED" ] || exit 1; printf '42 P %s\n' "$3" ;;
+quota) [ "$3" = 42 ] && [ "$4" = "$TEST_RESOLVED" ] || exit 1
+       printf '%s\n' "$TEST_QUOTA"; exit "$TEST_QUOTA_EXIT" ;;
+esac`)
+	t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("TEST_RESOLVED", "/lustre/project with spaces")
+	const remotePath = "/link with spaces/$(exit 19);'file"
+	t.Setenv("TEST_PATH", remotePath)
+	for _, tc := range []struct {
+		name, fs, quota, exit string
+		wantFree              int64
+	}{
+		{"over soft quota", "lustre", "/lustre 40000* 30000 100000 - 3 0 0 -", "0", 61440000},
+		{"wrapped filesystem", "lustre", "/very/long/filesystem\n 40000* 30000 100000* - 3 0 0 -", "0", 61440000},
+		{"hard limit reached", "lustre", "/lustre 100000 30000 100000 - 3 0 0 -", "0", 0},
+		{"no hard limit", "lustre", "/lustre 40000 30000 0 - 3 0 0 -", "0", -1},
+		{"quota command failed", "lustre", "/lustre 40000 30000 100000 - 3 0 0 -", "1", -1},
+		{"not Lustre", "ext4", "/lustre 40000 30000 100000 - 3 0 0 -", "0", -1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("TEST_FS", tc.fs)
+			t.Setenv("TEST_QUOTA", tc.quota)
+			t.Setenv("TEST_QUOTA_EXIT", tc.exit)
+			// Paths are literal data even with shell metacharacters.
+			pathArg, err := quoteOrEscapeShellPath("unix", remotePath)
+			require.NoError(t, err)
+			out, err := exec.Command("sh", "-c", lustreQuotaCommand(pathArg)).Output()
+			if tc.wantFree < 0 {
+				require.True(t, err != nil || parseLustreQuota(out) == nil)
+				return
+			}
+			require.NoError(t, err)
+			u := parseLustreQuota(out)
+			require.NotNil(t, u)
+			require.Equal(t, tc.wantFree, *u.Free)
+		})
+	}
+}
