+// aboutLustreQuota returns project quota usage for Lustre paths. It falls back
+// to the normal statvfs/df paths when Lustre tools or project quotas are unavailable.
+func (f *Fs) aboutLustreQuota(ctx context.Context) (*fs.Usage, error) {
+	aboutPath := f.remoteShellPath("")
+	if aboutPath == "" {
+		aboutPath = "."
+	}
+	pathArg, err := f.quoteOrEscapeShellPath(aboutPath)
+	if err != nil {
+		return nil, err
+	}
+	stdout, err := f.run(ctx, lustreQuotaCommand(pathArg))
+	if err != nil {
+		return nil, err
+	}
+	return parseLustreQuota(stdout), nil
+}
+
+// pathArg has already been escaped for the remote Unix shell.
+func lustreQuotaCommand(pathArg string) string {
+	return "p=" + pathArg + `; command -v lfs >/dev/null 2>&1 || exit 1
+r=$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")
+t=$(LC_ALL=C df -P -T "$r" 2>/dev/null | awk 'NR==2 {print $2}')
+[ "$t" = lustre ] || exit 1
+id=$(lfs project -d "$r" 2>/dev/null | awk 'NF >= 3 && $1 ~ /^[0-9]+$/ {print $1; exit}')
+[ -n "$id" ] || exit 1
+q=$(LC_ALL=C lfs quota -p "$id" "$r" 2>/dev/null) || exit 1
+printf '%s\n' "$q" | awk '
+NF >= 3 && $1 ~ /^[0-9]+[*]?$/ {used=$1; hard=$3}
+NF >= 4 && $2 ~ /^[0-9]+[*]?$/ && $1 !~ /^[0-9]+[*]?$/ {used=$2; hard=$4}
+used != "" {gsub(/[*]/,"",used); gsub(/[*]/,"",hard); print used, hard; exit}'`
+}
+
+func parseLustreQuota(stdout []byte) *fs.Usage {
+	fields := strings.Fields(string(stdout))
+	if len(fields) != 2 {
+		return nil
+	}
+	used, errUsed := strconv.ParseInt(fields[0], 10, 64)
+	hard, errHard := strconv.ParseInt(fields[1], 10, 64)
+	if errUsed != nil || errHard != nil || used < 0 || hard <= 0 || used > math.MaxInt64/1024 || hard > math.MaxInt64/1024 {
+		return nil
+	}
+	used *= 1024
+	hard *= 1024
+	free := hard - used
+	if free < 0 {
+		free = 0
+	}
+	return &fs.Usage{Total: fs.NewUsageValue(hard), Used: fs.NewUsageValue(used), Free: fs.NewUsageValue(free)}
 }
 
