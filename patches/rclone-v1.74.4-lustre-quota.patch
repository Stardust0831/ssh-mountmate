+// aboutLustreQuota returns project quota usage for Lustre paths. It falls back
+// to the normal statvfs/df paths when Lustre tools or project quotas are unavailable.
+func (f *Fs) aboutLustreQuota(ctx context.Context) (*fs.Usage, error) {
+	aboutPath := f.remoteShellPath("")
+	if aboutPath == "" {
+		aboutPath = "."
+	}
+	pathArg, err := f.quoteOrEscapeShellPath(aboutPath)
+	if err != nil {
+		return nil, err
+	}
+	cmd := "p=" + pathArg + "; command -v lfs >/dev/null 2>&1 || exit 1; r=$(readlink -f -- \"$p\" 2>/dev/null || printf '%s' \"$p\"); t=$(df -P -T \"$r\" 2>/dev/null | awk 'NR==2 {print $2}'); [ \"$t\" = lustre ] || exit 1; id=$(lfs project -d \"$r\" 2>/dev/null | awk 'NF >= 3 && $1 ~ /^[0-9]+$/ {print $1; exit}'); [ -n \"$id\" ] || exit 1; lfs quota -p \"$id\" \"$r\" 2>/dev/null | awk 'NF >= 4 && $2 ~ /^[0-9]+[*]?$/{gsub(/[*]/,\"\",$2); gsub(/[*]/,\"\",$4); print $2, $4; exit}'"
+	stdout, err := f.run(ctx, cmd)
+	if err != nil {
+		return nil, err
+	}
+	fields := strings.Fields(string(stdout))
+	if len(fields) < 2 {
+		return nil, nil
+	}
+	used, errUsed := strconv.ParseInt(fields[0], 10, 64)
+	hard, errHard := strconv.ParseInt(fields[1], 10, 64)
+	if errUsed != nil || errHard != nil || used < 0 || hard <= 0 {
+		return nil, nil
+	}
+	used *= 1024
+	hard *= 1024
+	free := hard - used
+	if free < 0 {
+		free = 0
+	}
+	return &fs.Usage{Total: fs.NewUsageValue(hard), Used: fs.NewUsageValue(used), Free: fs.NewUsageValue(free)}, nil
+}
