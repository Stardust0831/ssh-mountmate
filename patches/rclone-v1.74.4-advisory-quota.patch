@@ -0,0 +1,62 @@
+package vfs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/require"
+)
+
+type quotaStatfsFs struct {
+	fs.Fs
+	features fs.Features
+}
+
+func (f *quotaStatfsFs) Features() *fs.Features { return &f.features }
+
+// Exercise the actual statfs path used by FUSE, WinFsp and NFS, including its
+// cached snapshot. Ordinary filesystem full/near-full reports stay intact.
+func TestVFSStatfsLustreQuotaIsAdvisory(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		used, free int64
+		quota      bool
+	}{
+		{"quota nearly full", 99, 1, true},
+		{"quota full", 100, 0, true},
+		{"quota exceeded", 120, 0, true},
+		{"filesystem nearly full", 99, 1, false},
+		{"filesystem full", 100, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			usage := &fs.Usage{Total: fs.NewUsageValue(int64(100)), Used: fs.NewUsageValue(tc.used), Free: fs.NewUsageValue(tc.free)}
+			if tc.quota {
+				usage.LustreQuota = &fs.LustreQuotaUsage{}
+			}
+			backend := &quotaStatfsFs{features: fs.Features{
+				About: func(context.Context) (*fs.Usage, error) { return usage, nil },
+			}}
+			mount := &VFS{ctx: context.Background(), f: backend,
+				Opt: vfscommon.Options{DirCacheTime: fs.Duration(time.Hour), DiskSpaceTotalSize: -1}}
+			for range 2 {
+				total, used, free := mount.Statfs()
+				if tc.quota {
+					require.Equal(t, int64(unknownFreeBytes), total)
+					require.Equal(t, int64(0), used)
+					require.Equal(t, int64(unknownFreeBytes), free)
+				} else {
+					require.Equal(t, int64(100), total)
+					require.Equal(t, tc.used, used)
+					require.Equal(t, tc.free, free)
+				}
+				// Statfs must not rewrite the quota exposed by About/RC.
+				require.Equal(t, int64(100), *usage.Total)
+				require.Equal(t, tc.used, *usage.Used)
+				require.Equal(t, tc.free, *usage.Free)
+			}
+		})
+	}
+}
